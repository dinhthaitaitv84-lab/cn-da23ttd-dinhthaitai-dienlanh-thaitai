<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

<IfModule mod_cgi.c>
    Options -ExecCGI
</IfModule>

<IfModule mod_mime.c>
    RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .cgi
    RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .cgi
</IfModule>

<FilesMatch "(?i)\.(php[0-9]?|phtml|phar|cgi)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
